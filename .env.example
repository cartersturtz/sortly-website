# Stripe API keys — get from https://dashboard.stripe.com/apikeys
# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional (only needed if you use Stripe.js on the client / webhooks)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Price IDs — generate them by running:  npm run setup:stripe
STRIPE_PRICE_PERSONAL=price_xxxxxxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxxxxxx
STRIPE_PRICE_ONE_TIME=price_xxxxxxxxxxxxxxxx

# Your public site URL (must be reachable from the internet for Stripe redirects)
# Local:  http://localhost:3000   |   Deployed: https://sortly.ai
BASE_URL=http://localhost:3000
PORT=3000